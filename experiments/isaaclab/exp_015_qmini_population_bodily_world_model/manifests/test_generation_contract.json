{
  "schema_version": "exp015.transition.v1",
  "observation_dim": 41,
  "action_dim": 10,
  "observation_fields": [
    "base_linear_velocity_b[3]",
    "base_angular_velocity_b[3]",
    "projected_gravity_b[3]",
    "joint_position[10]",
    "joint_velocity[10]",
    "previous_actually_applied_action[10]",
    "left_foot_contact[1]",
    "right_foot_contact[1]"
  ],
  "required_separate_fields": ["action_proposed", "action_applied"],
  "hidden_analysis_fields": [
    "friction", "wind_xy", "fatigue_left", "fatigue_right"
