  "macro_speed_source": "FORMAL_MEASURED_QMINI_SAFE_RANGE",
  "randomness": {
    "per_episode_seed": true,
    "snapshot_rng_state": true,
    "same_snapshot_same_action_same_rng_replay_required": true
  },
  "reward": {
    "stored_separately": true,
    "teacher_specific_reward_as_input": false,
    "teacher_id_as_input": false
  },
  "training": {
    "world_model_training": false,
    "ppo_training": false,
    "teacher_training": false
  }
}
