    "WALK(speed)",
    "RUN(speed)",
    "TURN(angle, speed)",
    "STOP",
    "CROUCH(depth)",
    "STAND_UP"
  ],
  "stage0_execution_enabled": false,
  "invalid_or_unsupported_behavior": "fail_closed",
  "turn_is_continuous_command": true
}
